# Copiez ce fichier en .env et complétez-le.
APP_NAME=FlotteBox
# Générez une valeur aléatoire : python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=a-remplacer
# URL publique de l'application (utilisée dans les SMS envoyés aux locataires)
BASE_URL=https://flotte.mondomaine.fr
SECURE_COOKIES=true
TIMEZONE=Europe/Paris
# false = seul vous (via « python -m app.cli create-owner ») pouvez créer des sociétés
ALLOW_SIGNUP=false

# Codes d'accès des locations directes
ACCESS_CODE_LEAD_MINUTES=30
ACCESS_CODE_GRACE_HOURS=6

# SMS : console (affiché dans les logs) | twilio | brevo
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
BREVO_API_KEY=
BREVO_SENDER=FlotteBox

# Claude : assistant de messagerie Getaround + lecture des avis de contravention scannés
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Getaround / Pennylane : les jetons se saisissent dans Paramètres > Intégrations (par société)
GETAROUND_BASE_URL=https://api-eu.getaround.com/owner/v1
GETAROUND_SIGNATURE_HEADER=X-Getaround-Signature
PENNYLANE_BASE_URL=https://app.pennylane.com/api/external/v2
